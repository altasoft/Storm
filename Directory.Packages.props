<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="AltaSoft.DomainPrimitives" Version="9.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.324" />
    <PackageVersion Include="Microsoft.OData.Core" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="10.0.15" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.15" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <!--temporarily until Vulnerability is fixed in Microsoft.Data.SqlClient" Version="7.1.1"-->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="11.0.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <!--temporarily until Vulnerability is fixed in Microsoft.Data.SqlClient" Version="7.1.1"-->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>
