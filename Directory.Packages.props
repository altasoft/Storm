<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="AltaSoft.DomainPrimitives" Version="8.1.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.145" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="10.0.13" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.OData.Core" Version="9.0.0" />
	<!--temporarily until Vulnerability is fixed in Microsoft.Data.SqlClient" Version="7.1.1"-->
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="9.0.21" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="9.0.21" />
    <PackageVersion Include="System.Text.Json" Version="9.0.21" />
    <PackageVersion Include="Microsoft.OData.Core" Version="8.4.4" />
    <!--temporarily until Vulnerability is fixed in Microsoft.Data.SqlClient" Version="7.1.1"-->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="8.0.3" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <PackageVersion Include="Microsoft.OData.Core" Version="8.4.4" />
    <!--temporarily until Vulnerability is fixed in Microsoft.Data.SqlClient" Version="7.1.1"-->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
</Project>
